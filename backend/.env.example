# MarketPilot backend configuration. Copy to backend/.env and fill in. Never commit .env.
# Paper trading only: there is no real-money order code in this application.

# ---- Market data (required for any market-facing feature) -------------------
MARKET_DATA_PROVIDER=alpaca          # alpaca | massive | none
# Alpaca: free account at https://alpaca.markets (use PAPER account keys).
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_FEED=iex                      # iex (free, IEX-only real-time) | sip (Algo Trader Plus) | delayed_sip
# Massive (formerly Polygon.io): https://massive.com
MASSIVE_API_KEY=
MASSIVE_REALTIME=false               # true only if your plan includes real-time stocks

# ---- Earnings calendar (optional, strongly recommended) ----------------------
# Free key at https://finnhub.io. Without it, earnings dates are reported as UNVERIFIED.
FINNHUB_API_KEY=

# ---- AI analyst (optional) ----------------------------------------------------
AI_PROVIDER=anthropic                # anthropic | none
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium                     # low | medium | high | xhigh | max

# ---- Notifications (optional) -------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
ALERT_WEBHOOK_URL=                   # e.g. https://ntfy.sh/<your-private-topic> for phone push

# ---- Remote access (Cloudflare Tunnel) ------------------------------------------
# scripts/start-public.* sets PUBLIC_MODE=true; every page then requires this password.
APP_PASSWORD=
# PUBLIC_MODE=false

# ---- Runtime ------------------------------------------------------------------
# DATABASE_URL=sqlite:///./marketpilot.db           (default)
# DATABASE_URL=postgresql+psycopg://marketpilot:marketpilot@localhost:5432/marketpilot
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RUN_ENGINE=true
STALE_QUOTE_SECONDS=90

# ---- Optional brokerage: READ-ONLY, disabled by default -------------------------
ROBINHOOD_MCP_ENABLED=false
ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading
ROBINHOOD_MCP_TOKEN=
